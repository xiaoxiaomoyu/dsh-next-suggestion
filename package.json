{
  "name": "dsh-next-suggestion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "每轮回复结束后预测你的下一句话，在输入框上方给几条候选，点一下填进输入框。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "chat",
    "completion",
    "prediction"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoxiaomoyu/dsh-next-suggestion.git"
  },
  "homepage": "https://github.com/xiaoxiaomoyu/dsh-next-suggestion#readme",
  "bugs": {
    "url": "https://github.com/xiaoxiaomoyu/dsh-next-suggestion/issues"
  },
  "scripts": {    "test": "node test/host.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
